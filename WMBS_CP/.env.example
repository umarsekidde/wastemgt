## Payment provider switch
# PAYMENT_PROVIDER=pesapal

## Pesapal (LIVE)
# PESAPAL_ENV=live
# PESAPAL_CONSUMER_KEY=your_live_consumer_key
# PESAPAL_CONSUMER_SECRET=your_live_consumer_secret
# PESAPAL_IPN_ID=your_registered_ipn_id  # You can generate this via /api/pesapal/register-ipn?secret=SEED_SECRET
# PESAPAL_CALLBACK_URL=https://wastemgt-1v4i.onrender.com/payment/pesapal/callback

## Optional
# PESAPAL_CANCELLATION_URL=https://wastemgt-1v4i.onrender.com/customer

