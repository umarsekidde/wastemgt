<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
</head>
<body class="collector-dashboard">
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/collector"><span class="sidebar-icon">🚛</span><span>Jobs</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Collector Portal</div>
            <div class="text-muted">Live GPS and assigned jobs</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>
      <main class="dashboard-main">
        <h1>Collector Dashboard</h1>

        <section class="kpi-grid">
          <div class="kpi-card kpi-card-primary">
            <div class="kpi-label">Completed today</div>
            <div class="kpi-value" id="completedToday"><%= completedToday || 0 %></div>
            <div class="kpi-trend text-muted">Jobs marked as done</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Total earnings (UGX)</div>
            <div class="kpi-value"><%= totalEarnings || 0 %></div>
            <div class="kpi-trend text-muted">All time</div>
          </div>
        </section>

        <section class="dashboard-section section-row">
          <div class="card">
            <h2>Route & GPS</h2>
            <p class="text-muted">Share your live location while on duty.</p>
            <button type="button" id="startRouteBtn" class="btn btn-primary">Start route</button>
            <button type="button" id="endRouteBtn" class="btn btn-secondary" style="display:none">End route</button>
            <p id="trackingStatus" class="text-muted" style="margin-top: 0.5rem;">GPS: Waiting...</p>

            <h2 style="margin-top: 1.5rem;">My map</h2>
            <div id="collectorMap" style="height:300px;width:100%;background:#eee;"></div>
            <p id="collectorMapError" class="auth-error" style="display:none;"></p>
          </div>

          <div class="card">
            <h2>Waste categories</h2>
            <p class="text-muted">Use these categories when weighing and closing each assigned order.</p>
            <ul class="job-list" style="margin-top: 0.75rem;">
              <li class="job-item"><strong>Industrial Waste</strong><br><small>Factory/process waste. Keep hazardous materials separated and sealed.</small></li>
              <li class="job-item"><strong>Commercial Waste</strong><br><small>Shops, offices, and markets waste. Avoid mixing with household bins.</small></li>
              <li class="job-item"><strong>Household Waste</strong><br><small>Residential waste. Check for proper bagging before loading.</small></li>
              <li class="job-item"><strong>Agricultural Waste</strong><br><small>Farm/produce residue. Keep organic loads separate for proper disposal.</small></li>
            </ul>
          </div>
        </section>

        <section class="dashboard-section">
          <div class="card">
            <h2>Assigned jobs</h2>
            <p class="text-muted">Click an assigned job to enter category and measured weight (KG).</p>
            <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <ul class="job-list" style="margin-top: 0.75rem;">
              <% if (assignedJobs && assignedJobs.length) { assignedJobs.forEach(function(j) { %>
                <li class="job-item" data-id="<%= j.id %>">
                  <button type="button" class="btn btn-sm btn-secondary job-toggle-btn">Order #<%= j.id %> - <%= j.User ? j.User.name : '-' %></button>
                  <% if (j.User && j.User.phone) { %>
                    <br><small>Phone: <a href="tel:<%= j.User.phone %>"><%= j.User.phone %></a></small>
                  <% } %>
                  <br><small>Address: <%= j.address %></small>
                  <br><small><%= j.scheduled_date || '-' %> <%= j.scheduled_time_slot || '' %></small>
                  <form class="proof-form" style="display:none; margin-top: 0.6rem;" enctype="multipart/form-data">
                    <label>Waste category</label>
                    <select name="waste_category" required style="margin-bottom:0.5rem;">
                      <option value="">Select category</option>
                      <option value="industrial">Industrial Waste</option>
                      <option value="commercial">Commercial Waste</option>
                      <option value="household">Household Waste</option>
                      <option value="agricultural">Agricultural Waste</option>
                    </select>
                    <small class="category-notice text-muted" style="display:block; margin-bottom:0.5rem;">Choose a category to see a short handling notice.</small>
                    <label>Measured weight (KG)</label>
                    <input type="number" name="collected_weight_kg" min="0.1" step="0.01" placeholder="e.g. 12.50" required style="margin-bottom:0.5rem;">
                    <label>Proof image (optional)</label>
                    <input type="file" name="proof_image" accept="image/*">
                    <button type="submit" class="btn btn-sm btn-primary" style="margin-top:0.5rem;">Save weight & complete</button>
                  </form>
                </li>
              <% }); } else { %>
                <li>No assigned jobs</li>
              <% } %>
            </ul>
          </div>
        </section>

        <section class="dashboard-section">
          <button type="button" id="emergencyBtn" class="btn btn-danger">Report emergency</button>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script src="/js/collector-tracking.js"></script>
</body>
</html>
