<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <h1>Reset Password</h1>
    <% if (typeof error === 'string' && error) { %><p class="auth-error"><%= error %></p><% } %>
    <form method="post" action="/auth/reset-password" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
      <label>New password (min 8, upper, lower, number)</label>
      <div class="password-wrap">
        <input type="password" id="reset-password" name="password" required minlength="8" autocomplete="new-password">
        <label class="password-toggle"><input type="checkbox" data-toggle-password="reset-password"> Show password</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Reset password</button>
    </form>
  </div>
  <script src="/js/common.js"></script>
</body>
</html>
