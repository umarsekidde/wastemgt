<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card auth-card-wide">
    <h1>Customer Registration</h1>
    <% if (typeof error === 'string' && error) { %><p class="auth-error"><%= error %></p><% } %>
    <form method="post" action="/auth/register" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label>Full Name</label>
      <input type="text" name="name" required minlength="2">
      <label>Email</label>
      <input type="email" name="email" required autocomplete="email">
      <label>Password (min 8, include upper, lower, number)</label>
      <div class="password-wrap">
        <input type="password" id="register-password" name="password" required minlength="8" autocomplete="new-password">
        <label class="password-toggle"><input type="checkbox" data-toggle-password="register-password"> Show password</label>
      </div>
      <label>Phone</label>
      <input type="text" name="phone" placeholder="+256...">
      <label>Address</label>
      <input type="text" name="address" placeholder="Street, area">
      <label>Division (required – you will be assigned to this division's admin)</label>
      <select name="division_id" required>
        <option value="">Select your division</option>
        <% if (typeof divisions !== 'undefined' && divisions && divisions.length) { divisions.forEach(function(d) { %>
          <option value="<%= d.id %>"><%= d.name %></option>
        <% }); } %>
      </select>
      <% if (typeof divisions !== 'undefined' && (!divisions || divisions.length === 0)) { %>
        <p class="auth-error" style="margin-top:0.5rem; font-size:0.9rem;">No divisions available yet. Please contact support.</p>
      <% } %>
      <button type="submit" class="btn btn-primary btn-block">Register</button>
    </form>
    <p class="auth-links"><a href="/auth/login">Already have an account? Login</a></p>
  </div>
  <script src="/js/common.js"></script>
</body>
</html>
