<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-wrap">
      <img src="/images/logo.png" alt="WMBS logo" class="auth-logo">
    </div>
    <h1>Forgot Password</h1>
    <% if (typeof error === 'string' && error) { %><p class="auth-error"><%= error %></p><% } %>
    <% if (typeof success === 'string' && success) { %><p class="auth-success"><%= success %></p><% } %>
    <form method="post" action="/auth/forgot-password" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label>Email</label>
      <input type="email" name="email" required>
      <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
    </form>
    <p class="auth-links"><a href="/auth/login">Back to login</a></p>
  </div>
</body>
</html>
