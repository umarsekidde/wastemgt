<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/superadmin"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/superadmin/divisions"><span class="sidebar-icon">🗺</span><span>Areas</span></a>
        <a href="/superadmin/companies"><span class="sidebar-icon">🏢</span><span>Divisions</span></a>
        <a href="/superadmin/admins"><span class="sidebar-icon">👤</span><span>Admins & Collectors</span></a>
        <a href="/superadmin/customers"><span class="sidebar-icon">👥</span><span>Customers</span></a>
        <a href="/superadmin/broadcast"><span class="sidebar-icon">📣</span><span>Broadcast</span></a>
        <a href="/superadmin/audit-logs"><span class="sidebar-icon">🔍</span><span>Audit Logs</span></a>
        <a href="/superadmin/settings"><span class="sidebar-icon">⚙</span><span>Settings</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Broadcast Notification</div>
            <div class="text-muted">Send announcements to selected users</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>
      <main class="dashboard-main">
    <h1>Broadcast Notification</h1>
    <% if (typeof query !== 'undefined' && query && query.success) { %><p class="auth-success" style="margin-bottom:1rem;">Broadcast sent successfully.</p><% } %>
    <% if (typeof query !== 'undefined' && query && query.error) { %><p class="auth-error" style="margin-bottom:1rem;">Something went wrong. Please try again.</p><% } %>
    <form method="post" action="/superadmin/broadcast" class="card" style="max-width:620px;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label>Title</label>
      <input type="text" name="title" required class="form-control">
      <label>Message</label>
      <textarea name="message" required class="form-control" rows="4"></textarea>
      <label>Area (optional)</label>
      <select name="division_id" class="form-control">
        <option value="">All</option>
        <% (divisions || []).forEach(d => { %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
      </select>
      <label>Target roles (optional)</label>
      <select name="target_roles" multiple class="form-control">
        <option value="customer">Customer</option>
        <option value="collector">Collector</option>
        <option value="admin">Admin</option>
      </select>
      <button type="submit" class="btn btn-primary" style="margin-top:12px;">Send Broadcast</button>
    </form>
      </main>
    </div>
  </div>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
</body>
</html>
