<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/superadmin"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/superadmin/divisions"><span class="sidebar-icon">🗺</span><span>Areas</span></a>
        <a href="/superadmin/companies"><span class="sidebar-icon">🏢</span><span>Divisions</span></a>
        <a href="/superadmin/admins"><span class="sidebar-icon">👤</span><span>Admins & Collectors</span></a>
        <a href="/superadmin/customers"><span class="sidebar-icon">👥</span><span>Customers</span></a>
        <a href="/superadmin/broadcast"><span class="sidebar-icon">📣</span><span>Broadcast</span></a>
        <a href="/superadmin/audit-logs"><span class="sidebar-icon">🔍</span><span>Audit Logs</span></a>
        <a href="/superadmin/settings"><span class="sidebar-icon">⚙</span><span>Settings</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Audit Logs</div>
            <div class="text-muted">Trace every critical action in the system</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>
      <main class="dashboard-main">
    <h1>Audit Logs</h1>
    <form method="get" action="/superadmin/audit-logs" class="card" style="margin-bottom:1.5rem; padding:1rem;">
      <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:flex-end;">
        <div>
          <label for="date_from" style="display:block; font-size:0.85rem; margin-bottom:4px;">Date from</label>
          <input type="date" id="date_from" name="date_from" value="<%= typeof date_from !== 'undefined' ? date_from : '' %>" class="form-control" style="width:auto;">
        </div>
        <div>
          <label for="date_to" style="display:block; font-size:0.85rem; margin-bottom:4px;">Date to</label>
          <input type="date" id="date_to" name="date_to" value="<%= typeof date_to !== 'undefined' ? date_to : '' %>" class="form-control" style="width:auto;">
        </div>
        <div>
          <label for="action" style="display:block; font-size:0.85rem; margin-bottom:4px;">Action</label>
          <select id="action" name="action" class="form-control" style="width:auto;">
            <option value="">All actions</option>
            <% if (typeof distinctActions !== 'undefined' && distinctActions.length) { distinctActions.forEach(a => { %>
            <option value="<%= a %>" <%= (typeof action_filter !== 'undefined' && action_filter === a) ? 'selected' : '' %>><%= a %></option>
            <% }); } %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/superadmin/audit-logs" class="btn btn-secondary">Clear</a>
      </div>
    </form>
    <div class="card">
    <table>
      <thead><tr><th>Date</th><th>Time</th><th>Action</th><th>User</th><th>IP</th></tr></thead>
      <tbody>
        <% if (logs && logs.length) { logs.forEach(log => { %>
          <tr>
            <td><%= log.created_at ? new Date(log.created_at).toLocaleDateString() : '-' %></td>
            <td><%= log.created_at ? new Date(log.created_at).toLocaleTimeString() : '-' %></td>
            <td><%= log.action %></td>
            <td><%= log.User ? log.User.name : log.performed_by %></td>
            <td><%= log.ip_address || '-' %></td>
          </tr>
        <% }); } else { %><tr><td colspan="5">No logs</td></tr><% } %>
      </tbody>
    </table>
    </div>
    <% if (totalPages > 1) { %>
      <p style="margin-top:1rem;">Page <%= page %> of <%= totalPages %>.
        <% if (prevUrl) { %><a href="<%= prevUrl %>">Prev</a><% } %>
        <% if (nextUrl) { %><a href="<%= nextUrl %>">Next</a><% } %>
      </p>
    <% } %>
      </main>
    </div>
  </div>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
</body>
</html>
