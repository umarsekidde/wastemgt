<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <div class="sidebar-icon">W</div>
          <span>WMBS Admin</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/admin/collectors"><span class="sidebar-icon">🚛</span><span>Collectors</span></a>
        <a href="/admin/requests"><span class="sidebar-icon">📥</span><span>Requests</span></a>
        <a href="/admin/revenue"><span class="sidebar-icon">💳</span><span>Revenue</span></a>
        <a href="/admin/customers"><span class="sidebar-icon">👥</span><span>Customers</span></a>
        <a href="/admin/performance"><span class="sidebar-icon">📈</span><span>Performance</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Customers</div>
            <div class="text-muted">Households served by your company</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Customers</h1>
        <div class="card">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Area</th></tr></thead>
            <tbody>
              <% if (customers && customers.length) { customers.forEach(c => { %>
                <tr><td><%= c.name %></td><td><%= c.email %></td><td><%= c.phone || '-' %></td><td><%= c.address || '-' %></td><td><%= c.Division ? c.Division.name : '-' %></td></tr>
              <% }); } else { %><tr><td colspan="5">No customers</td></tr><% } %>
            </tbody>
          </table>
        </div>

        <h2 style="margin-top:1.5rem;">Customer complaints</h2>
        <div class="card">
          <table class="data-table">
            <thead><tr><th>Date</th><th>Customer</th><th>Subject</th><th>Message</th><th>Status</th></tr></thead>
            <tbody>
              <% if (allComplaints && allComplaints.length) { allComplaints.forEach(co => { %>
                <tr>
                  <td><%= co.created_at ? new Date(co.created_at).toLocaleString() : '-' %></td>
                  <td><%= co.User ? co.User.name : '-' %><% if (co.User && co.User.email) { %> <span class="text-muted">(<%= co.User.email %>)</span><% } %></td>
                  <td><%= co.subject %></td>
                  <td style="max-width:280px;"><%= (co.message || '').substring(0, 120) %><%= (co.message && co.message.length > 120) ? '…' : '' %></td>
                  <td><%= co.status %></td>
                </tr>
              <% }); } else { %><tr><td colspan="5">No complaints from customers yet</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
</body>
</html>
