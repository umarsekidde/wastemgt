<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/admin/collectors"><span class="sidebar-icon">🚛</span><span>Collectors</span></a>
        <a href="/admin/requests"><span class="sidebar-icon">📥</span><span>Requests</span></a>
        <a href="/admin/revenue"><span class="sidebar-icon">💳</span><span>Revenue</span></a>
        <a href="/admin/customers"><span class="sidebar-icon">👥</span><span>Customers</span></a>
        <a href="/admin/complaints"><span class="sidebar-icon">💬</span><span>Complaints</span></a>
        <a href="/admin/performance"><span class="sidebar-icon">📈</span><span>Performance</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Customer Complaints</div>
            <div class="text-muted">Conversation view of customer issues</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Complaints Chat Room</h1>
        <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="card">
          <div class="chat-room">
            <% if (complaints && complaints.length) { complaints.forEach(function(co) { %>
              <div class="chat-date-row complaint-card-head" data-open-id="<%= co.id %>">
                <span><%= co.created_at ? new Date(co.created_at).toLocaleDateString() : '-' %></span>
              </div>
              <div class="chat-message chat-message-in complaint-card-head" data-open-id="<%= co.id %>">
                <div class="chat-meta">
                  <strong><%= co.User ? co.User.name : 'Customer' %></strong>
                  <% if (co.User && co.User.email) { %><span>&lt;<%= co.User.email %>&gt;</span><% } %>
                </div>
                <div class="chat-subject"><%= co.subject %> <span class="chat-ticket">#<%= co.ticket_number || co.id %></span></div>
                <div class="chat-body"><%= co.message %></div>
                <div class="chat-foot">
                  <span class="chat-status chat-status-<%= (co.status || 'open').replace('_', '-') %>"><%= co.status || 'open' %></span>
                  <% if (co.WasteRequest && co.WasteRequest.id) { %>
                    <span class="chat-request-ref">Request #<%= co.WasteRequest.id %></span>
                  <% } %>
                  <span class="chat-time"><%= co.created_at ? new Date(co.created_at).toLocaleTimeString() : '' %></span>
                </div>
              </div>
              <div class="complaint-thread" id="thread-<%= co.id %>">
                <% if (co.thread && co.thread.length) { co.thread.forEach(function(msg) { %>
                  <div class="chat-message <%= msg.by === 'admin' ? 'chat-message-out' : 'chat-message-in' %>">
                    <div class="chat-meta"><strong><%= msg.name || (msg.by === 'admin' ? 'Admin' : 'Customer') %></strong></div>
                    <div class="chat-body"><%= msg.message %></div>
                    <div class="chat-foot">
                      <span class="chat-time"><%= msg.createdAt ? new Date(msg.createdAt).toLocaleString() : '' %></span>
                    </div>
                  </div>
                <% }); } %>
                <form class="complaint-reply-form" data-id="<%= co.id %>" style="margin-top:8px;">
                  <textarea name="message" class="form-control" rows="3" placeholder="Type your response..." required></textarea>
                  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:8px;">
                    <select name="status" class="form-control" style="width:auto; min-width:160px;">
                      <option value="">Keep current status (<%= co.status || 'open' %>)</option>
                      <option value="open">Open</option>
                      <option value="in_progress">In Progress</option>
                      <option value="resolved">Resolved</option>
                      <option value="closed">Closed</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Send Reply</button>
                  </div>
                </form>
              </div>
            <% }); } else { %>
              <p class="text-muted">No complaints from customers yet.</p>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script>
    window.browserNotifyConfig = {
      endpoint: '/admin/api/notifications/latest',
      storageKey: 'wmbs_notify_admin_last_id',
      pollMs: 15000,
      appTitle: 'WMBS Admin'
    };
  </script>
  <script src="/js/browser-notifications.js"></script>
  <script>
    (function() {
      document.querySelectorAll('.complaint-card-head').forEach(function(el) {
        el.addEventListener('click', function() {
          var id = this.getAttribute('data-open-id');
          var thread = document.getElementById('thread-' + id);
          if (!thread) return;
          thread.classList.toggle('is-open');
        });
      });

      document.querySelectorAll('.complaint-reply-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var complaintId = form.getAttribute('data-id');
          var messageEl = form.querySelector('textarea[name="message"]');
          var statusEl = form.querySelector('select[name="status"]');
          var submitBtn = form.querySelector('button[type="submit"]');
          var csrf = (document.getElementById('csrfToken') || {}).value || '';
          var message = (messageEl && messageEl.value) ? messageEl.value.trim() : '';
          if (!message) return;

          submitBtn.disabled = true;
          fetch('/admin/complaints/' + complaintId + '/reply', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'csrf-token': csrf
            },
            body: JSON.stringify({ message: message, status: statusEl ? statusEl.value : '', _csrf: csrf })
          })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (!d || !d.success) throw new Error((d && d.message) || 'Failed to send reply');
              window.location.reload();
            })
            .catch(function(err) {
              alert(err.message || 'Failed to send reply');
            })
            .finally(function() {
              submitBtn.disabled = false;
            });
        });
      });
    })();
  </script>
</body>
</html>
