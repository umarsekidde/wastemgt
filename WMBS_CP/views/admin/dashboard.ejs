<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/admin/collectors"><span class="sidebar-icon">🚛</span><span>Collectors</span></a>
        <a href="/admin/requests"><span class="sidebar-icon">📥</span><span>Requests</span></a>
        <a href="/admin/revenue"><span class="sidebar-icon">💳</span><span>Revenue</span></a>
        <a href="/admin/customers"><span class="sidebar-icon">👥</span><span>Customers</span></a>
        <a href="/admin/complaints"><span class="sidebar-icon">💬</span><span>Complaints</span></a>
        <a href="/admin/performance"><span class="sidebar-icon">📈</span><span>Performance</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title"><%= company ? company.name : 'Division Admin' %></div>
            <div class="text-muted">Waste Management & Billing</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
          <div class="user-pill">
            <div class="user-pill-avatar"></div>
            <span>Admin</span>
          </div>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Division Admin Dashboard</h1>

        <section class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-label">Total Customers</div>
            <div class="kpi-value" data-countup="<%= customers ? customers.length || 0 : 0 %>">0</div>
            <div class="kpi-trend">Active billing customers</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Total Waste Collected (Jobs)</div>
            <div class="kpi-value" data-countup="<%= requests ? requests.length || 0 : 0 %>">0</div>
            <div class="kpi-trend text-muted">Completed & in-progress pickups</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Active Trucks</div>
            <div class="kpi-value" data-countup="<%= trucks ? trucks.length || 0 : 0 %>">0</div>
            <div class="kpi-trend">Sending live GPS</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Revenue Today (UGX)</div>
            <div class="kpi-value" data-countup="<%= (monthlyRevenue && Object.values(monthlyRevenue).length) ? Object.values(monthlyRevenue)[Object.values(monthlyRevenue).length-1] : 0 %>">0</div>
            <div class="kpi-trend text-muted">Latest recorded period</div>
          </div>
        </section>

        <section class="section-row dashboard-section">
          <div class="card">
            <h2>Revenue trend</h2>
            <p class="text-muted">Monthly revenue performance</p>
            <p id="revenueChartMeta" class="text-muted" style="margin-bottom:8px;"></p>
            <div style="height:260px; max-height:40vh; min-height:180px;">
              <canvas id="revenueChart"></canvas>
            </div>
          </div>
          <div class="card map-card">
            <h2>Live Collector & Customer Map</h2>
            <p class="text-muted">Blue pin = collector · Green dot = customer pickup location</p>
            <div id="map"></div>
            <p id="lastUpdate" class="text-muted"></p>
            <p id="mapError" class="auth-error" style="display:none;"></p>
          </div>
        </section>

      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/maps.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script>
    window.browserNotifyConfig = {
      endpoint: '/admin/api/notifications/latest',
      storageKey: 'wmbs_notify_admin_last_id',
      pollMs: 15000,
      appTitle: 'WMBS Admin'
    };
  </script>
  <script src="/js/browser-notifications.js"></script>
  <script>
    (function() {
      var revenueData = <%- JSON.stringify(monthlyRevenue || {}) %>;
      var rawLabels = Object.keys(revenueData).sort();
      var values = rawLabels.map(function(k) { return Number(revenueData[k]) || 0; });
      var chartEl = document.getElementById('revenueChart');
      var chartMetaEl = document.getElementById('revenueChartMeta');
      function formatUGX(value) {
        return 'UGX ' + (Number(value) || 0).toLocaleString();
      }
      function toMonthLabel(isoMonth) {
        // Expects YYYY-MM and returns readable month label.
        if (!isoMonth || typeof isoMonth !== 'string' || isoMonth.indexOf('-') === -1) return isoMonth || '';
        var parts = isoMonth.split('-');
        var year = Number(parts[0]);
        var month = Number(parts[1]) - 1;
        if (!Number.isFinite(year) || !Number.isFinite(month)) return isoMonth;
        var date = new Date(year, month, 1);
        return date.toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
      }
      var labels = rawLabels.map(toMonthLabel);
      var maxValue = values.length ? Math.max.apply(null, values) : 0;
      var totalRevenue = values.reduce(function(sum, value) { return sum + value; }, 0);
      if (chartMetaEl) {
        if (!labels.length) {
          chartMetaEl.textContent = 'No revenue records yet.';
        } else if (labels.length === 1) {
          chartMetaEl.textContent = 'Only one month available (' + labels[0] + '). Add more periods to see a clearer trend.';
        } else {
          chartMetaEl.textContent = 'Period: ' + labels[0] + ' to ' + labels[labels.length - 1] + ' • Total: ' + formatUGX(totalRevenue);
        }
      }
      if (chartEl && labels.length) {
        new Chart(chartEl, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Revenue (UGX)',
              data: values,
              borderColor: '#0F4C81',
              borderWidth: 3,
              pointBackgroundColor: '#2EC4B6',
              pointBorderColor: '#0F4C81',
              pointBorderWidth: 1,
              pointRadius: values.length === 1 ? 6 : 4,
              pointHoverRadius: 6,
              backgroundColor: 'rgba(46,196,182,0.20)',
              tension: 0.3,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            aspectRatio: 2.2,
            interaction: { mode: 'index', intersect: false },
            scales: {
              y: {
                beginAtZero: true,
                suggestedMax: maxValue > 0 ? Math.ceil(maxValue * 1.2) : 1000,
                ticks: {
                  callback: function(value) { return formatUGX(value); },
                  maxTicksLimit: 6
                },
                grid: { color: 'rgba(148,163,184,0.25)' }
              },
              x: { grid: { display: false } }
            },
            plugins: {
              legend: { display: true, position: 'top' },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return ' ' + formatUGX(context.raw);
                  }
                }
              }
            }
          }
        });
      }
      if (typeof initAdminMap === 'function') initAdminMap('map', document.getElementById('lastUpdate'));
    })();
  </script>
</body>
</html>
