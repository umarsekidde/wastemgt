<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Customer Portal</div>
            <div class="text-muted">Manage your pickups and payments</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Customer Dashboard</h1>

        <section class="kpi-grid">
          <div class="kpi-card kpi-card-primary">
            <div class="kpi-label">Total Requests</div>
            <div class="kpi-value" data-countup="<%= requests ? requests.length || 0 : 0 %>">0</div>
            <div class="kpi-trend text-muted">All time</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Successful Payments</div>
            <div class="kpi-value" data-countup="<%= payments ? payments.filter(p => p.status === 'success').length || 0 : 0 %>">0</div>
            <div class="kpi-trend text-muted">Completed transactions</div>
          </div>
        </section>

        <section class="dashboard-section">
          <h2>Request pickup</h2>
          <form id="requestForm" class="card" style="max-width:640px;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="latitude" id="pickupLat" value="">
            <input type="hidden" name="longitude" id="pickupLng" value="">
            <label>Pickup location (click on the map or enter address below)</label>
            <div id="pickupMap" style="height:280px; width:100%; border-radius:8px; margin-bottom:12px;"></div>
            <label>Coordinates (filled when you select a place on the map)</label>
            <input type="text" id="pickupCoordinates" readonly class="form-control" placeholder="Latitude, Longitude" style="margin-bottom:12px;">
            <label>Address</label>
            <input type="text" name="address" id="pickupAddress" required class="form-control" placeholder="Street, area, or set by clicking the map">
            <label>Subscription</label>
            <select name="subscription_type" class="form-control">
              <option value="monthly">Monthly - 50000 UGX</option>
              <option value="weekly">Weekly - 15000 UGX</option>
              <option value="on_demand">On-demand - 20000 UGX</option>
            </select>
            <label>Scheduled date</label>
            <input type="date" name="scheduled_date" class="form-control">
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Submit request</button>
          </form>
        </section>

        <section class="dashboard-section">
          <h2>My requests</h2>
          <div class="card">
            <table>
              <thead><tr><th>ID</th><th>Address</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
              <tbody>
                <% if (requests && requests.length) { requests.forEach(function(r) { %>
                  <tr>
                    <td><%= r.id %></td>
                    <td><%= r.address %></td>
                    <td><%= r.scheduled_date || '-' %></td>
                    <td><%= r.status %></td>
                    <td><button type="button" class="btn btn-sm cancel-request" data-id="<%= r.id %>">Cancel</button> <button type="button" class="btn btn-sm pay-request" data-id="<%= r.id %>" data-amount="<%= r.amount %>">Pay</button></td>
                  </tr>
                <% }); } else { %><tr><td colspan="5">No requests</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="dashboard-section">
          <h2>Recent payments</h2>
          <div class="card">
            <table>
              <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Invoice</th></tr></thead>
              <tbody>
                <% if (payments && payments.length) { payments.forEach(function(p) { %>
                  <tr><td><%= p.created_at ? new Date(p.created_at).toISOString().split('T')[0] : '-' %></td><td><%= p.amount %> UGX</td><td><%= p.status %></td><td><a href="/customer/invoice/<%= p.id %>/download">Download</a></td></tr>
                <% }); } else { %><tr><td colspan="4">No payments</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script src="/js/pickup-map.js"></script>
  <script src="/js/payments.js"></script>
</body>
</html>
