<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/my-requests"><span class="sidebar-icon">📦</span><span>My Requests</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Customer Portal</div>
            <div class="text-muted">Manage your pickups and payments</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Customer Dashboard</h1>

        <section class="kpi-grid">
          <div class="kpi-card kpi-card-primary">
            <div class="kpi-label">Total Requests</div>
            <div class="kpi-value" data-countup="<%= requests ? requests.length || 0 : 0 %>">0</div>
            <div class="kpi-trend text-muted">All time</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Successful Payments</div>
            <div class="kpi-value" data-countup="<%= payments ? payments.filter(p => p.status === 'success').length || 0 : 0 %>">0</div>
            <div class="kpi-trend text-muted">Completed transactions</div>
          </div>
        </section>

        <section class="dashboard-section">
          <h2>Request pickup</h2>
          <form id="requestForm" class="card customer-form-card" style="max-width:640px;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="latitude" id="pickupLat" value="">
            <input type="hidden" name="longitude" id="pickupLng" value="">
            <label>Pickup location (click on the map or enter address below)</label>
            <div id="pickupMap" style="height:280px; width:100%; border-radius:8px; margin-bottom:12px;"></div>
            <label>Coordinates (filled when you select a place on the map)</label>
            <input type="text" id="pickupCoordinates" readonly class="form-control" placeholder="Latitude, Longitude" style="margin-bottom:12px;">
            <label>Address</label>
            <input type="text" name="address" id="pickupAddress" required class="form-control" placeholder="Street, area, or set by clicking the map">
            <label>Waste category</label>
            <select name="waste_category" class="form-control" required>
              <option value="">Select category</option>
              <option value="industrial">Industrial Waste</option>
              <option value="commercial">Commercial Waste</option>
              <option value="household">Household Waste</option>
              <option value="agricultural">Agricultural Waste</option>
            </select>
            <small class="text-muted" style="display:block; margin-top:8px;">
              Bill is estimated after weighing: 0-50KG=500, 51-100KG=600, 101-150KG=700, then +100 for every extra 50KG bracket.
            </small>
            <label>Scheduled date</label>
            <input type="date" name="scheduled_date" class="form-control">
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Submit request</button>
          </form>
        </section>

        <section class="dashboard-section" id="wastePaymentPanel" style="display:none;">
          <div class="card payment-card">
            <h2>Waste Payment</h2>
            <input type="hidden" id="defaultCustomerPhone" value="<%= user && user.phone ? user.phone : '' %>">
            <input type="hidden" id="defaultCustomerEmail" value="<%= user && user.email ? user.email : '' %>">
            <div class="payment-row"><strong>Customer:</strong> <span id="paymentCustomerName"><%= typeof user !== 'undefined' && user ? user.name : 'Customer' %></span></div>
            <div class="payment-row"><strong>Waste Collected:</strong> <span id="paymentWeightKg">-</span> KG</div>
            <div class="payment-row"><strong>Price:</strong> UGX <span id="paymentPrice">0.00</span></div>
            <hr>
            <div class="payment-total"><strong>Total Amount:</strong> UGX <span id="paymentTotal">0.00</span></div>
            <hr>
            <input type="hidden" id="paymentRequestId" value="">
            <label>Phone Number:</label>
            <input type="text" id="paymentPhone" class="form-control" placeholder="07XXXXXXXX" value="">
            <label>Email (Optional):</label>
            <input type="email" id="paymentEmail" class="form-control" placeholder="example@email.com" value="">
            <hr>
            <label>Choose Payment Method:</label>
            <div class="payment-methods customer-payment-methods">
              <button type="button" class="btn btn-secondary payment-method-btn active" data-method="mtn_momo">MTN MOMO</button>
              <button type="button" class="btn btn-secondary payment-method-btn" data-method="airtel_money">AIRTEL MONEY</button>
            </div>
            <hr>
            <button type="button" class="btn btn-primary" id="payNowBtn">PAY NOW</button>
            <button type="button" class="btn btn-sm btn-secondary" id="closePaymentPanelBtn" style="margin-top:8px;">Close</button>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script src="/js/pickup-map.js"></script>
  <script src="/js/payments.js"></script>
  <script>
    window.browserNotifyConfig = {
      endpoint: '/customer/api/notifications/latest',
      storageKey: 'wmbs_notify_customer_last_id',
      pollMs: 15000,
      appTitle: 'WMBS Customer',
      inAppPosition: 'top'
    };
  </script>
  <script src="/js/browser-notifications.js"></script>
</body>
</html>
