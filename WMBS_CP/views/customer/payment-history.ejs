<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/my-requests"><span class="sidebar-icon">📦</span><span>My Requests</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">Customer Portal</div>
            <div class="text-muted">View your payment history</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>Payment History</h1>
        <div class="card">
          <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Invoice</th><th>Download</th></tr></thead>
            <tbody>
              <% if (payments && payments.length) { payments.forEach(function(p) { %>
                <tr>
                  <td><%= p.created_at ? new Date(p.created_at).toISOString().split('T')[0] : '-' %></td>
                  <td><%= p.amount %> <%= p.currency || 'UGX' %></td>
                  <td><%= p.status %></td>
                  <td><%= p.invoice_number || '-' %></td>
                  <td><% if (p.status === 'success') { %><a href="/customer/invoice/<%= p.id %>/download" class="btn btn-sm btn-secondary">PDF</a><% } else { %>-<% } %></td>
                </tr>
              <% }); } else { %><tr><td colspan="5">No payments</td></tr><% } %>
            </tbody>
          </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script>
    window.pushNotifyConfig = {
      publicKeyEndpoint: '/customer/api/push/public-key',
      subscribeEndpoint: '/customer/api/push/subscribe',
      unsubscribeEndpoint: '/customer/api/push/unsubscribe',
      serviceWorkerPath: '/sw.js'
    };
  </script>
  <script src="/js/push-client.js"></script>
  <script src="/js/dashboard-ui.js"></script>
</body>
</html>
