<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">My Complaints</div>
            <div class="text-muted">Track and follow up your tickets</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>
      <main class="dashboard-main">
    <h1>My Complaints</h1>
    <form method="post" action="/customer/complaints" class="card" style="max-width:520px;margin-bottom:20px">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label>Subject</label>
      <input type="text" name="subject" required class="form-control">
      <label>Message</label>
      <textarea name="message" required class="form-control" rows="4"></textarea>
      <button type="submit" class="btn btn-primary" style="margin-top:12px;">Submit ticket</button>
    </form>
    <div class="card">
      <table>
        <thead><tr><th>Ticket</th><th>Subject</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
          <% if (complaints && complaints.length) { complaints.forEach(function(c) { %>
            <tr><td><%= c.ticket_number || c.id %></td><td><%= c.subject %></td><td><%= c.status %></td><td><%= c.created_at ? new Date(c.created_at).toISOString().split('T')[0] : '-' %></td></tr>
          <% }); } else { %><tr><td colspan="4">No complaints</td></tr><% } %>
        </tbody>
      </table>
    </div>
      </main>
    </div>
  </div>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
</body>
</html>
