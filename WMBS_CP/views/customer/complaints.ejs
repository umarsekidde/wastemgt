<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/my-requests"><span class="sidebar-icon">📦</span><span>My Requests</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">My Complaints</div>
            <div class="text-muted">Track and follow up your tickets</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>
      <main class="dashboard-main">
        <h1>My Complaints Chat</h1>
        <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <form method="post" action="/customer/complaints" class="card customer-form-card" style="max-width:620px;margin-bottom:20px">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <label>Subject</label>
          <input type="text" name="subject" required class="form-control" placeholder="What issue are you facing?">
          <label>Message</label>
          <textarea name="message" required class="form-control" rows="4" placeholder="Type your complaint details..."></textarea>
          <button type="submit" class="btn btn-primary" style="margin-top:12px;">Submit ticket</button>
        </form>
        <div class="card">
          <div class="chat-room">
            <% if (complaints && complaints.length) { complaints.forEach(function(c) { %>
              <div class="chat-date-row complaint-card-head" data-open-id="<%= c.id %>">
                <span><%= c.created_at ? new Date(c.created_at).toLocaleDateString() : '-' %></span>
              </div>
              <div class="chat-message chat-message-in complaint-card-head" data-open-id="<%= c.id %>">
                <div class="chat-meta">
                  <strong><%= user && user.name ? user.name : 'Customer' %></strong>
                  <span>#<%= c.ticket_number || c.id %></span>
                </div>
                <div class="chat-subject"><%= c.subject %></div>
                <div class="chat-body"><%= c.message %></div>
                <div class="chat-foot">
                  <span class="chat-status chat-status-<%= (c.status || 'open').replace('_', '-') %>"><%= c.status || 'open' %></span>
                  <span class="chat-time"><%= c.created_at ? new Date(c.created_at).toLocaleTimeString() : '' %></span>
                </div>
              </div>
              <div class="complaint-thread" id="thread-<%= c.id %>">
                <% if (c.thread && c.thread.length) { c.thread.forEach(function(msg) { %>
                  <div class="chat-message <%= msg.by === 'admin' ? 'chat-message-out' : 'chat-message-in' %>">
                    <div class="chat-meta"><strong><%= msg.name || (msg.by === 'admin' ? 'Admin' : (user && user.name ? user.name : 'Customer')) %></strong></div>
                    <div class="chat-body"><%= msg.message %></div>
                    <div class="chat-foot">
                      <span class="chat-time"><%= msg.createdAt ? new Date(msg.createdAt).toLocaleString() : '' %></span>
                    </div>
                  </div>
                <% }); } %>
                <form class="complaint-reply-form" data-id="<%= c.id %>" style="margin-top:8px;">
                  <textarea name="message" class="form-control" rows="3" placeholder="Write a follow-up message..." required></textarea>
                  <div style="margin-top:8px;">
                    <button type="submit" class="btn btn-primary btn-sm">Send Message</button>
                  </div>
                </form>
              </div>
            <% }); } else { %>
              <p class="text-muted">No complaints yet. Start by submitting one above.</p>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script>
    (function() {
      document.querySelectorAll('.complaint-card-head').forEach(function(el) {
        el.addEventListener('click', function() {
          var id = this.getAttribute('data-open-id');
          var thread = document.getElementById('thread-' + id);
          if (!thread) return;
          thread.classList.toggle('is-open');
        });
      });

      document.querySelectorAll('.complaint-reply-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var complaintId = form.getAttribute('data-id');
          var messageEl = form.querySelector('textarea[name="message"]');
          var submitBtn = form.querySelector('button[type="submit"]');
          var csrf = (document.getElementById('csrfToken') || {}).value || '';
          var message = (messageEl && messageEl.value) ? messageEl.value.trim() : '';
          if (!message) return;

          submitBtn.disabled = true;
          fetch('/customer/complaints/' + complaintId + '/reply', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'csrf-token': csrf
            },
            body: JSON.stringify({ message: message, _csrf: csrf })
          })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (!d || !d.success) throw new Error((d && d.message) || 'Failed to send message');
              window.location.reload();
            })
            .catch(function(err) {
              alert(err.message || 'Failed to send message');
            })
            .finally(function() {
              submitBtn.disabled = false;
            });
        });
      });
    })();
  </script>
</body>
</html>
