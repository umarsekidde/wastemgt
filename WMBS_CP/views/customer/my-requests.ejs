<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WMBS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/images/logo.png" alt="WMBS logo" class="header-logo">
          <span>Waste Management &amp; Billing System</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/customer"><span class="sidebar-icon">🏠</span><span>Dashboard</span></a>
        <a href="/customer/my-requests"><span class="sidebar-icon">📦</span><span>My Requests</span></a>
        <a href="/customer/notifications"><span class="sidebar-icon">🔔</span><span>Notifications</span></a>
        <a href="/customer/payment-history"><span class="sidebar-icon">💳</span><span>Payments</span></a>
        <a href="/customer/complaints"><span class="sidebar-icon">✉</span><span>Complaints</span></a>
        <a href="/auth/logout"><span class="sidebar-icon">⏏</span><span>Logout</span></a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button id="sidebarToggle" class="icon-button" type="button">☰</button>
          <div>
            <div class="topbar-title">My Requests</div>
            <div class="text-muted">Track each request from pending to completion</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button id="darkToggle" class="icon-button" type="button">🌙</button>
        </div>
      </header>

      <main class="dashboard-main">
        <h1>My Requests</h1>
        <div class="card">
          <div class="table-wrap">
          <table>
            <thead><tr><th>ID</th><th>Address</th><th>Date</th><th>Status</th><th>Bill (UGX)</th><th>Payment</th><th>Action</th></tr></thead>
            <tbody>
              <% if (requests && requests.length) { requests.forEach(function(r) { %>
                <tr>
                  <td><%= r.id %></td>
                  <td><%= r.address %></td>
                  <td><%= r.scheduled_date || '-' %></td>
                  <td>
                    <div class="request-status-label">
                      <%= r.status === 'pending' ? 'Pending - request sent to admin' : '' %>
                      <%= r.status === 'assigned' ? 'Scheduled - assigned to collector' : '' %>
                      <%= r.status === 'in_progress' ? 'In Progress - collector on the way / weighing' : '' %>
                      <%= r.status === 'completed' ? 'Complete - payment done and collection closed' : '' %>
                      <%= r.status === 'cancelled' ? 'Cancelled' : '' %>
                    </div>
                    <div class="request-status-flow">
                      <% if (r.status === 'cancelled') { %>
                        <span class="request-step request-step-done">Pending</span>
                        <span class="request-step request-step-done">Assigned</span>
                        <span class="request-step request-step-cancelled">Cancelled</span>
                        <span class="request-step">In Progress</span>
                        <span class="request-step">Completed</span>
                      <% } else { %>
                        <span class="request-step <%= ['pending','assigned','in_progress','completed'].includes(r.status) ? 'request-step-done' : '' %>">Pending</span>
                        <span class="request-step <%= ['assigned','in_progress','completed'].includes(r.status) ? 'request-step-done' : '' %>">Assigned</span>
                        <span class="request-step <%= ['in_progress','completed'].includes(r.status) ? 'request-step-done' : '' %>">In Progress</span>
                        <span class="request-step <%= r.status === 'completed' ? 'request-step-done' : '' %>">Completed</span>
                      <% } %>
                    </div>
                  </td>
                  <td><%= r.amount ? Number(r.amount).toFixed(2) : '0.00' %></td>
                  <td>
                    <% if (paymentStatusByRequest && paymentStatusByRequest[r.id]) { %>
                      <%= paymentStatusByRequest[r.id] %>
                    <% } else if (Number(r.amount || 0) <= 0) { %>
                      Awaiting weighing
                    <% } else { %>
                      Not paid
                    <% } %>
                  </td>
                  <td class="action-cell">
                    <% if (['pending', 'assigned'].includes(r.status)) { %>
                      <button type="button" class="btn btn-sm cancel-request" data-id="<%= r.id %>">Cancel</button>
                    <% } %>
                    <% if (['assigned', 'in_progress'].includes(r.status) && Number(r.amount || 0) > 0) { %>
                      <button type="button" class="btn btn-sm btn-primary pay-request" data-id="<%= r.id %>" data-amount="<%= r.amount %>" data-notes="<%= (r.notes || '').replace(/"/g, '&quot;') %>">Pay with Mobile Money</button>
                    <% } else if (['assigned', 'in_progress'].includes(r.status) && Number(r.amount || 0) <= 0) { %>
                      <button type="button" class="btn btn-sm btn-secondary" disabled>Awaiting weight update</button>
                    <% } %>
                    <% if (paymentStatusByRequest && ['pending', 'success'].includes(paymentStatusByRequest[r.id])) { %>
                      <button type="button" class="btn btn-sm btn-secondary confirm-payment" data-id="<%= r.id %>">Confirm Payment</button>
                    <% } %>
                  </td>
                </tr>
              <% }); } else { %><tr><td colspan="7">No requests</td></tr><% } %>
            </tbody>
          </table>
          </div>
        </div>

        <section class="dashboard-section" id="wastePaymentPanel" style="display:none;">
          <div class="card payment-card">
            <h2>Waste Payment</h2>
            <input type="hidden" id="defaultCustomerPhone" value="<%= user && user.phone ? user.phone : '' %>">
            <input type="hidden" id="defaultCustomerEmail" value="<%= user && user.email ? user.email : '' %>">
            <div class="payment-row"><strong>Customer:</strong> <span id="paymentCustomerName"><%= typeof user !== 'undefined' && user ? user.name : 'Customer' %></span></div>
            <div class="payment-row"><strong>Waste Collected:</strong> <span id="paymentWeightKg">-</span> KG</div>
            <div class="payment-row"><strong>Price:</strong> UGX <span id="paymentPrice">0.00</span></div>
            <hr>
            <div class="payment-total"><strong>Total Amount:</strong> UGX <span id="paymentTotal">0.00</span></div>
            <hr>
            <input type="hidden" id="paymentRequestId" value="">
            <label>Phone Number:</label>
            <input type="text" id="paymentPhone" class="form-control" placeholder="07XXXXXXXX" value="">
            <label>Email (Optional):</label>
            <input type="email" id="paymentEmail" class="form-control" placeholder="example@email.com" value="">
            <hr>
            <label>Choose Payment Method:</label>
            <div class="payment-methods customer-payment-methods">
              <button type="button" class="btn btn-secondary payment-method-btn active" data-method="mtn_momo">MTN MOMO</button>
              <button type="button" class="btn btn-secondary payment-method-btn" data-method="airtel_money">AIRTEL MONEY</button>
            </div>
            <hr>
            <button type="button" class="btn btn-primary" id="payNowBtn">PAY NOW</button>
            <button type="button" class="btn btn-sm btn-secondary" id="closePaymentPanelBtn" style="margin-top:8px;">Close</button>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/dashboard-ui.js"></script>
  <script src="/js/payments.js"></script>
  <script>
    window.browserNotifyConfig = {
      endpoint: '/customer/api/notifications/latest',
      storageKey: 'wmbs_notify_customer_last_id',
      pollMs: 15000,
      appTitle: 'WMBS Customer',
      inAppPosition: 'top'
    };
  </script>
  <script src="/js/browser-notifications.js"></script>
</body>
</html>
